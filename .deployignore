# Deployment ignore file - files/folders to exclude from deployment

# Dependencies (will install fresh on server)
node_modules/
frontend/node_modules/
backend/node_modules/

# Source files (only deploy built files)
frontend/src/
backend/src/
backend/test-scripts/

# Environment files (configure on server)
.env
.env.*
*.env

# Development files
*.md
docs/
.vscode/
.idea/
.git/
.gitignore
.eslintrc*
.prettierrc*
tsconfig.json
vite.config.ts
postcss.config.js
tailwind.config.js

# Test files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts not needed
*.map
*.tsbuildinfo

# Uploads (user generated content - handle separately)
uploads/*
backend/uploads/*

# Scripts not needed in production
scripts/
backend/scripts/
backend/migrations/

# Deployment scripts themselves
deploy*.ps1
deploy*.sh
.deployignore

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Bitbucket pipelines
bitbucket-pipelines.yml

# Development server scripts
start-dev*.ps1
start-dev*.sh
setup*.sh

# License and readme
LICENSE
README.md

# Documentation
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md

# Shared source (keep compiled version only)
shared/*.ts
!shared/*.js
