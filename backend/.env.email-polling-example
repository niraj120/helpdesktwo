# =============================================================================
# EMAIL POLLING SERVICE CONFIGURATION
# =============================================================================

# Email Polling Interval (Cron format)
# Default: Every 2 minutes
# Examples:
#   */1 * * * * = Every 1 minute
#   */5 * * * * = Every 5 minutes
#   */10 * * * * = Every 10 minutes
#   0 * * * * = Every hour at minute 0
EMAIL_POLLING_INTERVAL=*/2 * * * *

# Maximum emails to fetch per configuration per cycle
# Prevents memory issues with large mailboxes
# Remaining emails will be processed in next cycle
# Default: 50
MAX_EMAILS_PER_FETCH=50
