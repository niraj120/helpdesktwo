# Environment Configuration
NODE_ENV=development
PORT=3003

# Database Configuration
# Development (local) MongoDB
MONGODB_LOCAL_URI=mongodb://localhost:27017/sac_helpdesk
# Production MongoDB — set the real, credentialed URI only in the server's own
# .env (never committed). Placeholder shown here on purpose.
MONGODB_PRODUCTION_URI=mongodb://<user>:<password>@<host>:27017/sac_helpdesk?authSource=admin
DB_NAME=sac_helpdesk

# JWT Configuration
# Generate strong, UNIQUE values (production refuses to start with a placeholder
# or a secret < 32 chars): node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# CORS Configuration - All URLs come from .env
# Development URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3003
API_URL=http://localhost:3003/api
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:3003

# Production URLs
PRODUCTION_FRONTEND_URL=https://helpdesk.hubblehox.ai
PRODUCTION_BACKEND_URL=https://api.helpdesk.hubblehox.ai
PRODUCTION_API_URL=https://api.helpdesk.hubblehox.ai/api
PRODUCTION_ALLOWED_ORIGINS=https://helpdesk.hubblehox.ai,https://api.helpdesk.hubblehox.ai

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# GCP Storage Configuration
GCP_STORAGE_URL=https://console.cloud.google.com/storage/browser/helpdesk-knowledge-base?project=helpdesk-dev-478611

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:3001
PRODUCTION_SOCKET_CORS_ORIGIN=https://helpdesk.hubblehox.ai
SOCKET_CORS_ORIGIN=http://localhost:3001
PRODUCTION_SOCKET_CORS_ORIGIN=https://helpdesk.hubblehox.ai

# API Keys (Optional)
# HRMS_API_URL=https://hrms.example.com/api
# HRMS_API_KEY=your-hrms-api-key

# ── OIDC SSO (Phase 3) ──────────────────────────────────────────────────────
# The production Keycloak flow. Leave OIDC_ENABLED unset/false to keep it off.
# Secrets belong in the secret manager, NOT committed. Values from the Keycloak
# team (see docs/KEYCLOAK_SSO_ORG_INFORMATION_REQUEST.md).
OIDC_ENABLED=false
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/hubblehox-dev
OIDC_CLIENT_ID=helpdesk-web
OIDC_CLIENT_SECRET=
KEYCLOAK_API_AUDIENCE=helpdesk-api
OIDC_REDIRECT_URI=https://<helpdesk-host>/api/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://<helpdesk-host>/signed-out
# Exact URLs Keycloak may post-logout to (comma-separated; exact match).
OIDC_POST_LOGOUT_ALLOWLIST=https://<helpdesk-host>/signed-out
KEYCLOAK_CLOCK_TOLERANCE_SECONDS=60
# Controlled-migration only: link (issuer,sub) to a UNIQUE email on first login.
OIDC_MIGRATION_LINK_BY_EMAIL=false
# BFF session lifetimes.
SESSION_TTL_MINUTES=60
SESSION_ABSOLUTE_TTL_HOURS=8
OIDC_SESSION_COOKIE=hd_session
# Parent self-service flow (LMS → Helpdesk). Dedicated client + the MDM claim
# that maps a logged-in parent to their Guardian-Master row.
OIDC_PARENT_CLIENT_ID=helpdesk-parent
OIDC_PARENT_CLIENT_SECRET=
OIDC_PARENT_REDIRECT_URI=https://<helpdesk-host>/api/auth/oidc/callback
OIDC_PARENT_MDM_CLAIM=mdm_parent_id
